lse</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>false</ShowLabel><Properties SaveInSnapshot="true" Constant="false" AccessType="public" StaticVariable="false"><Type>double[][]</Type><InitialValue Class="CodeValue"><Code>new double[6][4]</Code></InitialValue></Properties></Variable><Variable Class="PlainVariable"><Id>1900000000006</Id><Name>a3d_shipStartedNs</Name><X>0</X><Y>0</Y><Label><X>0</X><Y>-20</Y></Label><PublicFlag>false</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>false</ShowLabel><Properties SaveInSnapshot="true" Constant="false" AccessType="public" StaticVariable="false"><Type>long[]</Type><InitialValue Class="CodeValue"><Code>new long[6]</Code></InitialValue></Properties></Variable><Variable Class="PlainVariable"><Id>1900000000007</Id><Name>a3d_shipShown</Name><X>0</X><Y>0</Y><Label><X>0</X><Y>-20</Y></Label><PublicFlag>false</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>false</ShowLabel><Properties SaveInSnapshot="true" Constant="false" AccessType="public" StaticVariable="false"><Type>boolean[]</Type><InitialValue Class="CodeValue"><Code>new boolean[6]</Code></InitialValue></Properties></Variable><Variable Class="PlainVariable"><Id>1900000000008</Id><Name>a3d_shipPosition</Name><X>0</X><Y>0</Y><Label><X>0</X><Y>-20</Y></Label><PublicFlag>false</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>false</ShowLabel><Properties SaveInSnapshot="true" Constant="false" AccessType="public" StaticVariable="false"><Type>java.util.function.IntFunction&lt;double[]&gt;</Type><InitialValue Class="CodeValue"><Code>(slot)-&gt;{double[] p=this.a3d_shipRoutes[slot];
double f=Math.max(0,Math.min(1,(System.nanoTime()-this.a3d_shipStartedNs[slot])/800000000.0));
return new double[]{p[0]+f*(p[2]-p[0]),p[1]+f*(p[3]-p[1])};}</Code></InitialValue></Properties></Variable><Variable Class="PlainVariable"><Id>1900000000009</Id><Name>a3d_position</Name><X>0</X><Y>0</Y><Label><X>0</X><Y>-20</Y></Label><PublicFlag>false</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>false</ShowLabel><Properties SaveInSnapshot="true" Constant="false" AccessType="public" StaticVariable="false"><Type>java.util.function.Function&lt;Job,double[]&gt;</Type><InitialValue Class="CodeValue"><Code>(j)-&gt;{
double[] route=j.a3d_route;
double progress=Math.max(0,Math.min(1,(System.nanoTime()-j.a3d_startedNs)/800000000.0));
double total=0;
for(int k=2;k&lt;route.length;k+=2) total+=Math.hypot(route[k]-route[k-2],route[k+1]-route[k-1]);
double remaining=total*progress;
for(int k=2;k&lt;route.length;k+=2){
 double length=Math.hypot(route[k]-route[k-2],route[k+1]-route[k-1]);
 if(remaining&lt;=length &amp;&amp; length&gt;0){double f=remaining/length;
  return new double[]{route[k-2]+f*(route[k]-route[k-2]),route[k-1]+f*(route[k+1]-route[k-1])};}
 remaining-=length;
}
return new double[]{route[route.length-2],route[route.length-1]};
}</Code></InitialValue></Properties></Variable><Variable Class="PlainVariable"><Id>1900000000010</Id><Name>a3d_moveTo</Name><X>0</X><Y>0</Y><Label><X>0</X><Y>-20</Y></Label><PublicFlag>false</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>false</ShowLabel><Properties SaveInSnapshot="true" Constant="false" AccessType="public" StaticVariable="false"><Type>java.util.function.BiConsumer&lt;Job,double[]&gt;</Type><InitialValue Class="CodeValue"><Code>(j,target)-&gt;{
// Keep a just-started rework route when a zero-time service-start changes its endpoint.
if(j.a3d_route.length&gt;4 &amp;&amp; System.nanoTime()-j.a3d_startedNs&lt;800000000L &amp;&amp; target.length==2){
 j.a3d_route[j.a3d_route.length-2]=target[0];j.a3d_route[j.a3d_route.length-1]=target[1];
 return;
}
double[] current=this.a3d_position.apply(j);
double[] route=new double[target.length+2];route[0]=current[0];route[1]=current[1];
System.arraycopy(target,0,route,2,target.length);
j.a3d_route=route;j.a3d_startedNs=System.nanoTime();
}</Code></InitialValue></Properties></Variable></Variables><Connectors><Connector><Id>1800000000117</Id><Name>link1</Name><X>0</X><Y>0</Y><Label><X>0</X><Y>-20</Y></Label><PublicFlag>false</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><SourceEmbeddedObjectReference><PackageName>p3_synthetic_assembly</PackageName><ClassName>Main</ClassName><ItemName>source</ItemName></SourceEmbeddedObjectReference><SourceConnectableItemReference><PackageName>com.anylogic.libraries.processmodeling</PackageName><ClassName>Source</ClassName><ItemName>out</ItemName></SourceConnectableItemReference><TargetEmbeddedObjectReference><PackageName>p3_synthetic_assembly</PackageName><ClassName>Main</ClassName><ItemName>chooseMode</ItemName></TargetEmbeddedObjectReference><TargetConnectableItemReference><PackageName>com.anylogic.libraries.processmodeling</PackageName><ClassName>SelectOutput</ClassName><ItemName>in</ItemName></TargetConnectableItemReference><Points><Point><X>2350.0</X><Y>190</Y></Point><Point><X>2450.0</X><Y>190</Y></Point></Points></Connector><Connector><Id>1800000000118</Id><Name>link2</Name><X>0</X><Y>0</Y><Label><X>0</X><Y>-20</Y></Label><PublicFlag>false</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><SourceEmbeddedObjectReference><PackageName>p3_synthetic_assembly</PackageName><ClassName>Main</ClassName><ItemName>componentSource</ItemName></SourceEmbeddedObjectReference><SourceConnectableItemReference><PackageName>com.anylogic.libraries.processmodeling</PackageName><ClassName>Source</ClassName><ItemName>out</ItemName></SourceConnectableItemReference><TargetEmbeddedObjectReference><PackageName>p3_synthetic_assembly</PackageName><ClassName>Main</ClassName><ItemName>componentBuffer</ItemName></TargetEmbeddedObjectReference><TargetConnectableItemReference><PackageName>com.anylogic.libraries.processmodeling</PackageName><ClassName>Queue</ClassName><ItemName>in</ItemName></TargetConnectableItemReference><Points><