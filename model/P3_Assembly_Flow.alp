util.function.DoubleSupplier)()-&gt;{if (reworkProbability&lt;0 || reworkProbability&gt;0.5 || !Double.isFinite(reworkProbability))
 throw new IllegalArgumentException("reworkProbability must be in [0,0.5]");
if (maxRework&lt;0 || maxRework&gt;10)
 throw new IllegalArgumentException("maxRework must be in [0,10]");
if (inputMode!=0 &amp;&amp; inputMode!=1) throw new IllegalArgumentException("inputMode must be 0 or 1");
if (inputMode==1 &amp;&amp; replayMode) throw new IllegalArgumentException("Fitted marginals (inputMode=1) require finite mode: replay must reproduce the recorded elapsed rows exactly");
if (componentMode!=0 &amp;&amp; componentMode!=1) throw new IllegalArgumentException("componentMode must be 0 or 1");
if (!Double.isFinite(componentMeanInterarrival) || componentMeanInterarrival&lt;=0)
 throw new IllegalArgumentException("componentMeanInterarrival must be finite and positive");
if (warmupHours!=0) throw new UnsupportedOperationException("NOT_IMPLEMENTED: steady-state warm-up; finite terminating runs require warmupHours=0 (Welch deletion happens in analysis, not the model)");
if (scenarioIndex&lt;0 || scenarioIndex&gt;5 || !Double.isFinite(meanInterarrival) || meanInterarrival&lt;=0 || !Double.isFinite(serviceScale) || serviceScale&lt;=0 || scenarioOrders&lt;1 || scenarioOrders&gt;10000)
 throw new IllegalArgumentException("Invalid SYNTHETIC scenario parameter");
if(capKitting&lt;1 || capAssembly&lt;1 || capTest&lt;1 || capQuality&lt;1 || capHandover&lt;1)
 throw new IllegalArgumentException("Capacities must be positive");
if(verificationMode &amp;&amp; (replayMode || scenarioIndex!=0 || capKitting!=verificationServers || verificationMeanService&lt;=0 || serviceScale!=1))
 throw new IllegalArgumentException("M/M/1 verification requires finite mode, scenario=0, capKitting=1, meanInterarrival=2, serviceScale=1");
if(!java.util.Arrays.asList("baseline","arrival","service","rework","component","input","validation","steady").contains(studyLabel))
 throw new IllegalArgumentException("studyLabel must be one of baseline, arrival, service, rework, component, input, validation, steady");
if(!"baseline".equals(studyLabel) &amp;&amp; (replayMode || verificationMode))
 throw new IllegalArgumentException("Non-baseline studies require finite fitted-data mode");getEngine().setStopTime(Double.POSITIVE_INFINITY);
arrivalRng=new java.util.Random(11001L+repSeed);
rowRng=new java.util.Random(12001L+repSeed); qualityRng=new java.util.Random(13001L+repSeed);
for(int k=0;k&lt;5;k++) stageRng[k]=new java.util.Random(21001L+1000L*k+repSeed);
reworkRng=new java.util.Random(14001L+repSeed); componentRng=new java.util.Random(15001L+repSeed);
capArray=new int[]{capKitting+(scenarioIndex==1?1:0),capAssembly+(scenarioIndex==2?1:0),capTest+(scenarioIndex==3?1:0),capQuality+(scenarioIndex==4?1:0),capHandover+(scenarioIndex==5?1:0)};
nativeLog.setLength(0); nativeLog.append("P3_META,SYNTHETIC\n");
nativeLog.append("P3_CONFIG,"+repSeed+","+scenarioIndex+","+replayMode+","+(replayMode?samples.length:scenarioOrders)+","+meanInterarrival+","+serviceScale+","+jointBootstrap+","+reworkProbability+","+warmupHours+","+capKitting+","+capAssembly+","+capTest+","+capQuality+","+capHandover+","+inputMode+","+componentMode+","+componentMeanInterarrival+","+maxRework+"\n");
if(verificationMode) nativeLog.append("P3_VERIFICATION_MODE,"+(verificationServers==1?"MM1":"MMC")+",lambda="+(1/meanInterarrival)+",mu="+(1/verificationMeanService)+"\n"); return replayMode ? samples[0][0] : -Math.log(1-arrivalRng.nextDouble())*meanInterarrival;}).getAsDouble()</Code><Unit Class="TimeUnits">HOUR</Unit></Value></Parameter><Parameter><Name>interarrivalTime</Name><Value Class="CodeUnitValue"><Code>replayMode ? (arrivalCursor+1&lt;samples.length ? samples[++arrivalCursor][0]-samples[arrivalCursor-1][0] : 1e9) : -Math.log(1-arrivalRng.nextDouble())*meanInterarrival</Code><Unit Class="TimeUnits">HOUR</Unit></Value></Parameter><Parameter><Name>limitArrivals</Name><Value Class="CodeValue"><Code>true</Code></Value></Parameter><Parameter><Name>maxArrivals</Name><Value Class="CodeValue"><Code>replayMode ? samples.length : scenarioOrders</Code></Value></Parameter><Parameter><Name>locationType</Name><Value Class="CodeValue"><Code>self.LOCATION_NOT_SPECIFIED</Code></Value></Parameter><Parameter><Name>onExit</Name><Value Class="CodeValue"><Code>Job j=(Job)agent; j.jobId=ordersIn++; j.releaseTime=time();
int row = replayMode ? j.jobId : rowRng.nextInt(samples.length);
j.rowIndex=row; j.qualityDraw=qualityRng.nextDouble();
j.assignedReworks = (reworkProbability&lt;=0) ? 0 : Math.min(maxRework,(int)Math.floor(Math.log(Math.max(j.qualityDraw,1e-300))/Math.log(reworkProbability)));
for(int idx=0;idx&lt;2*maxRework;idx++) j.reworkDraws[idx]=reworkRng.nextDouble();
for(int k=0;k&lt;5;k++) { double u=stageRng[k].nextDouble(); j.draws[k]=u;
 int r = (replayMode || jointBootstrap) ? row : Math.min(samples.length-1,(int)(u*samples.length));
 j.duration[k]=verificationMode ? (k==0 ? -Math.log(1-u)*verificationMeanService : 0) : (inputMode==1 ? fittedDuration.apply(k,u) : samples[r][k+1])*(replayMode?1.0:serviceScale); }
if(j.jobId&lt;5) recordLog.accept("P3_CRN,"+repSeed+","+scenarioIndex+","+j.jobId+","+row+","+java.util.Arrays.toString(j.draws)+","+j.qualityDraw);
recordLog.accept("P3_IN,"+time()+","+ordersIn+","+ordersOut+","+(ordersIn-ordersOut));
animRelease.accept(j); if(!replayMode &amp;&amp; componentMode==0) componentSource.inject(1);</Code></Value></Parameter><Parameter><Name>newEntity</Name><Value Class="EntityCodeValue"><IsAgentEntity>true</IsAgentEntity><EntityEmbeddedObject><Id>1800000000087</Id><ActiveObjectClass><PackageName>p3_synthetic_assembly</PackageName><ClassName>Job</ClassName></ActiveObjectClass><Parameters /><ReplicationFlag>true</ReplicationFlag><Replication Class="CodeValue"><Code>100</Code></Replication><CollectionType>ARRAY_LIST_BASED</CollectionType><InitialLocationType>XYZ</InitialLocationType><InitializationType>SPECIFIED_NUMBER</InitializationType></EntityEmbeddedObject></Value></Parameter></Parameters><ReplicationFlag>false</ReplicationFlag><Replication Class="CodeValue"><Code>100</Code></Replication><CollectionType>ARRAY_LIST_BASED</CollectionType><InitialLocationType>XYZ</InitialLocationType><ColumnCode Class="CodeValue"><Code>0</Code></ColumnCode><RowCode Class="CodeValue"><Code>0</Code></RowCode><LocationNameCode Class="CodeValue"><Code>""</Code></LocationNameCode><InitializationType>SPECIFIED_NUMBER</InitializationType></EmbeddedObject><EmbeddedObject><Id>1800000000088</Id><Name>chooseMode</Name><X>2450.0</X><Y>190</Y><Label><X>0</X><Y>-20</Y></Label><PublicFlag>false</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><ActiveObjectClass><PackageName>com.anylogic.libraries.processmodeling</PackageName><ClassName>SelectOutput</ClassName></ActiveObjectClass><Parameters><Parameter><Name>condition</Name><Value Class="CodeValue"><Code>replayMode</Code></Value></Parameter><Parameter><Name>conditionIsProbabilistic</Name><Value Class="CodeValue"><Code>false</Code></Value></Parameter></Parameters><ReplicationFlag>false</ReplicationFlag><Replication Class="CodeValue"><Code>100</Code></Replication><CollectionType>ARRAY_LIST_BASED</CollectionType><InitialLocationType>XYZ</InitialLocationType><ColumnCode Class="CodeValue"><Code>0</Code></ColumnCode><RowCode 